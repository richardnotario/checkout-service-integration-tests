{
  "request": {
    "method": "POST",
    "urlPath": "/pay",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.cardNumber == '4111111111111111')]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "status": "APPROVED" }
  }
}